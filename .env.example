# ─── Supabase (EU region, e.g. eu-central-1 Frankfurt) ────────────────────────
# Local defaults are printed by `pnpm db:start` (supabase start).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used by the worker, seed scripts and admin actions.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (worker / pg-boss / seed). Use the session pooler (port 5432) in prod.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── CV parsing & classification (ParserProvider) ──────────────────────────────
# anthropic | mock   (mock = deterministic heuristic parser, no network; used in tests/demo)
PARSER_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ─── Embeddings (EmbeddingProvider) ────────────────────────────────────────────
# local  = Xenova/multilingual-e5-base via @huggingface/transformers in the worker (768 dims, no data leaves our infra)
# voyage | openai = hosted APIs (must also be 768-dim compatible, see src/core/providers/embedding)
# fake   = deterministic hashing embedding for tests / offline demo
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=Xenova/multilingual-e5-base
VOYAGE_API_KEY=
OPENAI_API_KEY=

# ─── Connectors ────────────────────────────────────────────────────────────────
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTOR_ENCRYPTION_KEY=

# ─── Worker / jobs ─────────────────────────────────────────────────────────────
# Run admin "Sync now" inline instead of queueing (local dev / E2E without a running worker).
INLINE_SYNC=0
# Months of inactivity before an account is deleted (a warning mail goes out 30 days before).
RETENTION_INACTIVE_MONTHS=12
RETENTION_WARNING_DAYS=30
# console | smtp
MAILER=console
SMTP_URL=
MAIL_FROM="JobMatch <no-reply@jobmatch.example>"

# ─── Tests ─────────────────────────────────────────────────────────────────────
# E2E_BASE_URL=http://localhost:3000   # reuse a running server instead of `pnpm start`
# PLAYWRIGHT_CHROMIUM_PATH=/path/to/chrome
